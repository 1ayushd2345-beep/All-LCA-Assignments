#for tuples 
tup1=("Aparna","Anita","geeta","sunita")
print("your original student tuple is",tup1)
#add student name
#for adding student name in the tuple we have to change tuple into list
new_list=list(tup1)
new_list.append("Curie")
#convert list in tuple again
tup2=tuple(new_list)
print("new tuple of students affter addition of name is",tup2)
#delete
list2=list(tup2)
list2.remove("geeta")
tup3=tuple(list2)
print("new tuple of students after deleting element is", tup3)

#update
list3=list(tup3)
list3[2]="Veena"
tup4=tuple(list3)
print("new tuple of students after updating",tup4)


